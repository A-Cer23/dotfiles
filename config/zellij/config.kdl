// Zellij config — https://zellij.dev/documentation/configuration
//
// Start in "locked" mode so every key goes straight to Neovim/lazygit.
// Press Ctrl+g to unlock Zellij, use its shortcuts (shown in the bottom bar),
// then Ctrl+g again to lock.
default_mode "locked"

pane_frames false
show_startup_tips false
copy_on_select true

// Restore sessions after closing the terminal: `zellij attach` or `zellij ls`
session_serialization true
